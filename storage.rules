rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Multi-tenant scoped document uploads
    // firms/{firmId}/clients/{clientId}/documents/{fileName}
    match /firms/{firmId}/clients/{clientId}/documents/{fileName} {
      
      // Helper check for file size (<= 25MB) and allowed extensions
      function isValidSize() {
        return request.resource.size <= 25 * 1024 * 1024;
      }
      
      function isValidType() {
        return request.resource.contentType.matches('application/pdf')
            || request.resource.contentType.matches('image/jpeg')
            || request.resource.contentType.matches('image/png')
            || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document')
            || request.resource.contentType.matches('application/msword');
      }

      // Read permission: Staff of the firm or the authenticated client
      allow read: if request.auth != null && 
        (request.auth.token.firmId == firmId || request.auth.token.clientId == clientId);

      // Write permission: Must be valid size and type, scoped to tenant
      allow write: if request.auth != null && 
        (request.auth.token.firmId == firmId || request.auth.token.clientId == clientId) &&
        isValidSize() &&
        isValidType();

      // Delete only by Admin / Case Manager
      allow delete: if request.auth != null && 
        request.auth.token.firmId == firmId && 
        (request.auth.token.role == 'Admin' || request.auth.token.role == 'CaseManager');
    }
  }
}
