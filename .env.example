# IntakeIQ Firebase & Environment Configuration
# Optional: If not provided, IntakeIQ seamlessly runs in Zero-Config Mock/Seed Mode for instant testing.

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Optional Transactional Email Keys (Resend / SendGrid / Trigger Email Extension)
RESEND_API_KEY=re_123456789
EMAIL_FROM=notifications@yourdomain.com
